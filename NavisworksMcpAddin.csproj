<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ============================================================================
    Navisworks MCP Bridge — full build

    Builds a single in-process plugin (MCPBridge.dll) that hosts a tiny
    HTTP listener on port 8765 inside Navisworks. The Python MCP server
    (../server_http.py) talks to it over plain HTTP/JSON.

    Dependencies and why:
      System.Text.Json     JSON parsing and serialization for the HTTP API.
                           Pulls a handful of transitive deps (System.Memory,
                           System.Buffers, etc.) — all of them MUST land next
                           to MCPBridge.dll, hence CopyLocalLockFileAssemblies.

      Autodesk.Navisworks.Api / Clash   Navisworks API. <Private>false</Private>
                           keeps these OUT of the output folder — Navisworks
                           supplies them at runtime from its install dir.
    ============================================================================
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>

    <!-- Folder name in Plugins\ MUST equal AssemblyName MUST equal Plugin attribute -->
    <AssemblyName>MCPBridge</AssemblyName>
    <RootNamespace>NavisworksMcpAddin</RootNamespace>

    <LangVersion>10.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>

    <!-- Keep the output path simple: bin\Release\, not bin\Release\net48\ -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- Navisworks API references.
       Pick the target release with -p:NavisworksVersion=2026|2027 (default 2026);
       pass -p:NavisworksInstallDir=... too if Navisworks is not in the default place.
       Each version gets its own output folder: bin\Release\2026\, bin\Release\2027\ -->
  <PropertyGroup>
    <NavisworksVersion Condition="'$(NavisworksVersion)' == ''">2026</NavisworksVersion>
    <NavisworksInstallDir Condition="'$(NavisworksInstallDir)' == ''">C:\Program Files\Autodesk\Navisworks Manage $(NavisworksVersion)</NavisworksInstallDir>
    <OutputPath>bin\$(Configuration)\$(NavisworksVersion)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(NavisworksVersion)\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- Built-in .NET Framework 4.8 references that ship with Windows -->
  <ItemGroup>
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.Api.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Clash">
      <HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.Clash.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- No NuGet packages — JSON is hand-rolled to avoid version conflicts with
       whatever System.Text.Json copy Navisworks itself happens to load. -->

</Project>
